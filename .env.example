DATABASE_URL=postgresql://postgres:password@localhost:5432/mydb

# Email notifications (optional — Gmail SMTP)
# Use a Gmail App Password, not your regular Gmail password.
# Generate at: Google Account → Security → 2FA → App Passwords
# Copy the 16-character password and remove spaces.
NOTIFY_EMAIL_FROM=your.gmail@gmail.com
NOTIFY_EMAIL_PASSWORD=abcdefghijklmnop
NOTIFY_EMAIL_TO=admin@yourcompany.com
NOTIFY_REPO_URL=https://github.com/kidu90/prisma-Drift-Resolver

# Approval gate (optional)
# true = skip the PR label gate (local/CI testing)
# false or unset = require drift-approved label on a Pull Request
AUTO_APPROVE=true
PR_NUMBER=
